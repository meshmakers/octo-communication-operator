<?xml version="1.0" encoding="utf-8"?>
<!--
    AB#5478 section 2.3 — structured JSON logs with trace correlation.

    COPY. The canonical file is octo-common-services/samples/SampleWebService/nlog.config, and
    octo-common-services/tests/Observability.Tests/ReferenceLogConfigurationTests loads that file
    from disk and pins its behaviour. Change it there first.

    ${otel-trace-id} and ${otel-span-id} come from Meshmakers.Common.Observability, referenced
    directly by this project. NLog resolves renderers from the assembly it is NAMED, not
    transitively, so that name has to match exactly — and an unregistered renderer does not fail,
    it renders as literal text.

    The default levels below reproduce exactly what this process logged before, so the layout is
    the only behaviour that changes here.
-->
<nlog xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://www.nlog-project.org/schemas/NLog.xsd">

    <!--
        Registers ${otel-trace-id} and ${otel-span-id}. Declarative on purpose: Program.cs parses
        this file through LogManager.Setup().LoadConfigurationFromFile(...) before anything else
        runs, so registering the renderers in code would have to happen before that call in every
        entry point. An unregistered renderer does not fail — it renders as literal text.
    -->
    <extensions>
        <add assembly="Meshmakers.Common.Observability" />
    </extensions>

    <!--
        Log level per deployment instead of per commit. OCTO_LOG_LEVEL covers our own code,
        OCTO_LOG_LEVEL_ROOT everything else (frameworks, drivers). The adapter image used to pin
        minlevel="Debug" in the repository, which is the documented origin of the DEBUG flood that
        made up 96 % of all log volume and was being treated with a collector-side spam filter —
        dropping records only after they had been generated, shipped and paid for.
    -->
    <variable name="octoMinLevel" value="${environment:OCTO_LOG_LEVEL:whenEmpty=Info}" />
    <variable name="rootMinLevel" value="${environment:OCTO_LOG_LEVEL_ROOT:whenEmpty=Info}" />

    <targets>
        <!--
            Named "console", not "coloredConsole". DiagnosticsService.ReconfigureLogLevelAsync
            resolves the target by name and accepts both spellings, so a service can migrate
            independently of the shared package.

            Colour is gone because nothing reads it: the only consumer is a container log file.
        -->
        <target name="console" xsi:type="Console">
            <layout xsi:type="JsonLayout" includeEventProperties="true" includeScopeProperties="true">
                <attribute name="timestamp" layout="${date:format=yyyy-MM-ddTHH\:mm\:ss.fffZ:universalTime=true}" />
                <attribute name="level" layout="${level:uppercase=true}" />
                <attribute name="logger" layout="${logger}" />
                <attribute name="callsite" layout="${callsite:className=true:includeNamespace=false:methodName=true}" />
                <attribute name="message" layout="${message}" />
                <attribute name="trace_id" layout="${otel-trace-id}" />
                <attribute name="span_id" layout="${otel-span-id}" />
                <!--
                    One escaped string, not a multi-line block: JSON escaping turns the newlines
                    into \n so the record stays a single line and the filelog receiver keeps it
                    as one log record.
                -->
                <attribute name="exception.type" layout="${exception:format=type}" />
                <attribute name="exception.message" layout="${exception:format=message}" />
                <attribute name="exception.stacktrace" layout="${exception:format=tostring:maxInnerExceptionLevel=5}" />
            </layout>
        </target>
    </targets>

    <rules>
        <logger name="Meshmakers.*" minlevel="${var:octoMinLevel}" writeTo="console" final="true" />
        <logger name="*" minlevel="${var:rootMinLevel}" writeTo="console" />
    </rules>
</nlog>
