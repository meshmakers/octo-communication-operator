<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <AssemblyName>Meshmakers.Octo.Communication.Operator</AssemblyName>
    <RootNamespace>Meshmakers.Octo.Communication.Operator</RootNamespace>
    <Configurations>Debug;Release;DebugL</Configurations>
    <Platforms>AnyCPU</Platforms>
    <EnablePreviewFeatures>true</EnablePreviewFeatures>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="KubeOps.Generator" Version="13.1.2" OutputItemType="Analyzer" ReferenceOutputAssembly="false">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="KubeOps.Operator.Web" Version="13.1.2" />
    <PackageReference Include="Meshmakers.Octo.Sdk.ServiceClient" Version="$(OctoCoreLibVersion)" />
    <PackageReference Include="NLog.Web.AspNetCore" Version="6.2.0" />
    <PackageReference Include="YamlDotNet" Version="18.1.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Meshmakers.Octo.Communication.Operator.Tests" />
  </ItemGroup>

</Project>
